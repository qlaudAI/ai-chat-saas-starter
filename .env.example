# Copy to .env.local for development. NEVER commit .env.local.

# ─── Clerk ────────────────────────────────────────────────────────
# Get from dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# ─── qlaud ────────────────────────────────────────────────────────
# Master-scope key — mints per-user keys + reads usage rollups.
# Get from qlaud.ai/keys → "+ New key" → Master scope.
QLAUD_MASTER_KEY=qlk_live_replace_me

# ─── Stripe ───────────────────────────────────────────────────────
# Test keys for development; flip to live for production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Stripe Price IDs for the tiers — create them in Stripe → Products.
STRIPE_PRICE_ID_PRO=price_replace_me

# ─── Database (optional) ──────────────────────────────────────────
# This starter uses Clerk's user metadata to store the qlaud key, so no
# database is strictly required. If you outgrow that, swap in Postgres
# / Turso / D1 — there's a `lib/db.ts` adapter point to extend.
